{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["herramientas/**/*.mjs", "fuente/js/**/*.js", "pruebas/**/*.mjs", "playwright.config.mjs"],
  "exclude": ["node_modules", "dist", "dist-previa", "fuente/js/terceros"]
}
